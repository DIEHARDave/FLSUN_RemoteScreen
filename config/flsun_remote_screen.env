# FLSUN_RemoteScreen options. install.sh copies this file to
# ~/printer_data/config/flsun_remote_screen.env once; edit that copy, then
# restart the flsun-remote-screen service.
#
#   --mapping auto|helixscreen|tslib|linear
#       Touch calibration to follow. auto (the default) uses HelixScreen's
#       when HelixScreen is running and FLSun's /etc/pointercal when the
#       stock screen is.
#   --compression 0-9
#       PNG compression. 1 (the default) is fastest on the T1 Pro's CPU.
#   --touch /dev/input/event1    --fb /dev/fb0    --port 8093
REMOTE_SCREEN_ARGS=
